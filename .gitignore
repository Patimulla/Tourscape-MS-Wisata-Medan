# ============================================================
# CodeIgniter 4 Web
# Folder: sig-tempat-wisata-medan
# ============================================================

# Environment / secrets
sig-tempat-wisata-medan/.env

# Composer dependencies
sig-tempat-wisata-medan/vendor/

# Writable runtime files
sig-tempat-wisata-medan/writable/cache/*
sig-tempat-wisata-medan/writable/debugbar/*
sig-tempat-wisata-medan/writable/logs/*
sig-tempat-wisata-medan/writable/session/*
sig-tempat-wisata-medan/writable/uploads/*

# Keep writable folders themselves
!sig-tempat-wisata-medan/writable/cache/.gitkeep
!sig-tempat-wisata-medan/writable/debugbar/.gitkeep
!sig-tempat-wisata-medan/writable/logs/.gitkeep
!sig-tempat-wisata-medan/writable/session/.gitkeep
!sig-tempat-wisata-medan/writable/uploads/.gitkeep

# ============================================================
# Secrets (global safety net)
# ============================================================

**/.env
**/.env.*
!**/.env.example

*.pem
*.key
*.p12
*.jks
*.keystore

# Optional local database files
*.sqlite
*.sqlite3

